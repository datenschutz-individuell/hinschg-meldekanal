# Copy to /etc/hinweise-deadlines.env. KEY=VALUE, read by the systemd unit and by scripts/deadlines.php.
# Folder holding the portals (<kunde>/portal, <kunde>/cases)
HINWEISE_WURZEL=/srv/hinweise
# Operator: reports nobody else receives, errors; Reply-To of all mails
FRISTEN_AN=meldestelle@example.org
# Optional: domain of the operator's own team members; only they get the weekly reminder of due deletions
FRISTEN_INTERN=example.org
# Optional: how the operator calls the script, shown in those reminders; the user must be the unit's User=
# (per-portal units hinweise-deadlines@: sudo -u hinweise-%k hinweise-deadlines, %k = portal)
FRISTEN_BEFEHL=sudo -u http hinweise-deadlines
