[Unit]
Description=Hinweisportale: Fristen nach HinSchG melden
Documentation=https://github.com/datenschutz-individuell/hinschg-meldekanal/blob/main/README.md

[Service]
Type=oneshot
# The web server user (WEBUSER of the install script); the script refuses to run as anyone else
User=http
Group=http
# HINWEISE_WURZEL, FRISTEN_AN, optional FRISTEN_INTERN and FRISTEN_BEFEHL (example: hinweise-deadlines.env.example);
# the script also reads the file on manual calls
EnvironmentFile=/etc/hinweise-deadlines.env
ExecStart=/usr/bin/php /usr/local/bin/hinweise-deadlines --mail
StateDirectory=hinweise-deadlines
StateDirectoryMode=0700
UMask=0077
# sendmail hands over to Postfix via setgid postdrop: hence no NoNewPrivileges, maildrop writable
ReadWritePaths=/var/spool/postfix/maildrop
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
PrivateDevices=yes
CapabilityBoundingSet=
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
SystemCallArchitectures=native
